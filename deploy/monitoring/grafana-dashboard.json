{
  "title": "SanHolo Hosted",
  "uid": "sanholo-hosted",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "sanholo"
  ],
  "timezone": "utc",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "US-023: per-tenant bot panels from the tenant scrape and Nomad, and the control plane's own metrics. deploy/README.md section 9.",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(sanholo_api_requests_total{job=\"sanholo-tenants\"}, tenant)",
          "refId": "tenant"
        },
        "definition": "label_values(sanholo_api_requests_total{job=\"sanholo-tenants\"}, tenant)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Tenants",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "API requests per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (tenant) (rate(sanholo_api_requests_total{job=\"sanholo-tenants\",tenant=~\"$tenant\"}[5m])) * 60",
          "legendFormat": "{{tenant}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Game throttles (429) per 10 minutes",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (tenant) (increase(sanholo_api_throttled_total{job=\"sanholo-tenants\",tenant=~\"$tenant\"}[10m]))",
          "legendFormat": "{{tenant}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Bot restarts in the last hour (all allocations)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (tenant) (max_over_time(nomad_client_allocs_restart{exported_job=~\"sanholo-tenant-.+\",tenant=~\"$tenant\"}[1h]) - (last_over_time(nomad_client_allocs_restart{exported_job=~\"sanholo-tenant-.+\",tenant=~\"$tenant\"}[1h] offset 1h) or max_over_time(nomad_client_allocs_restart{exported_job=~\"sanholo-tenant-.+\",tenant=~\"$tenant\"}[1h]) * 0))",
          "legendFormat": "{{tenant}}"
        }
      ]
    },
