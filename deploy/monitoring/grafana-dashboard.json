        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (tenant) (go_memstats_sys_bytes{job=\"sanholo-tenants\",tenant=~\"$tenant\"})",
          "legendFormat": "{{tenant}} sys"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (tenant) (go_memstats_heap_inuse_bytes{job=\"sanholo-tenants\",tenant=~\"$tenant\"})",
          "legendFormat": "{{tenant}} heap in use"
        }
      ]
    },
